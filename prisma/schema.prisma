generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(255)
  vatNumber       String?          @unique @map("vat_number") @db.VarChar(20)
  entityType      entitytype       @map("entity_type")
  contactEmail    String?          @map("contact_email") @db.VarChar(255)
  contactName     String?          @map("contact_name") @db.VarChar(255)
  address         String?          @db.VarChar(500)
  notes           String?          @db.VarChar(2000)
  vatScheme       String?          @map("vat_scheme") @db.VarChar(50)
  salesChannels   String[]         @default([]) @map("sales_channels")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  clientType      String?          @map("client_type") @db.VarChar(50)
  displayName     String?          @map("display_name") @db.VarChar(255)
  countryCode     String           @default("GB") @map("country_code") @db.VarChar(2)
  companyNumber   String?          @map("company_number") @db.VarChar(20)
  utr             String?          @db.VarChar(20)
  niNumber        String?          @map("ni_number") @db.VarChar(20)
  vatRegistered   Boolean          @default(false) @map("vat_registered")
  // Relationships
  chatSessions      ChatSession[]
  contacts          ClientContact[]
  engagements       Engagement[]
  counterparties    Counterparty[]
  financialAccounts FinancialAccount[]
  documents         Document[]
  auditLogs         AuditLog[]

  @@map("clients")
}

model Document {
  id                Int                @id @default(autoincrement())
  clientId          Int                @map("client_id")
  engagementId      Int?               @map("engagement_id")
  documentTypeId    Int?               @map("document_type_id")
  counterpartyId    Int?               @map("counterparty_id")
  accountId         Int?               @map("account_id")
  // File information
  filename          String             @db.VarChar(500)
  s3Key             String             @unique @map("s3_key") @db.VarChar(1000)
  fileHash          String             @map("file_hash") @db.VarChar(64)
  contentType       String?            @map("content_type") @db.VarChar(100)
  fileSize          Int?               @map("file_size")
  // Document metadata
  title             String?            @db.VarChar(255)
  source            String             @default("upload") @db.VarChar(50)
  documentDate      DateTime?          @map("document_date") @db.Date
  periodStart       DateTime?          @map("period_start") @db.Date
  periodEnd         DateTime?          @map("period_end") @db.Date
  meta              Json?              @db.Json
  // Processing status
  status            documentstatus
  processingError   String?            @map("processing_error") @db.VarChar(2000)
  // Key extracted fields (denormalized from DocumentVersion)
  invoiceNumber     String?            @map("invoice_number") @db.VarChar(100)
  invoiceDate       DateTime?          @map("invoice_date") @db.Date
  supplierName      String?            @map("supplier_name") @db.VarChar(255)
  supplierVatNumber String?            @map("supplier_vat_number") @db.VarChar(20)
  customerName      String?            @map("customer_name") @db.VarChar(255)
  customerVatNumber String?            @map("customer_vat_number") @db.VarChar(20)
  netAmount         Decimal?           @map("net_amount") @db.Decimal(12, 2)
  vatAmount         Decimal?           @map("vat_amount") @db.Decimal(12, 2)
  grossAmount       Decimal?           @map("gross_amount") @db.Decimal(12, 2)
  vatRate           Decimal?           @map("vat_rate") @db.Decimal(5, 2)
  currency          String?            @db.VarChar(3)
  description       String?            @db.VarChar(2000)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  // Relationships
  // WARNING: Using Restrict instead of Cascade to prevent accidental data loss.
  // Client deletion will fail if documents exist. Consider soft-delete or manual cleanup.
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  engagement        Engagement?        @relation(fields: [engagementId], references: [id])
  documentTypeRef   DocumentType?      @relation(fields: [documentTypeId], references: [id])
  counterparty      Counterparty?      @relation(fields: [counterpartyId], references: [id])
  account           FinancialAccount?  @relation(fields: [accountId], references: [id])
  versions          DocumentVersion[]
  validationResults ValidationResult[]
  requestItems      RequestItem[]      @relation("RequestItemDocuments")

  @@index([fileHash], map: "ix_documents_file_hash")
  @@index([clientId], map: "ix_documents_client_id")
  @@index([engagementId], map: "ix_documents_engagement_id")
  @@index([documentTypeId], map: "ix_documents_document_type_id")
  @@index([counterpartyId], map: "ix_documents_counterparty_id")
  @@index([accountId], map: "ix_documents_account_id")
  @@map("documents")
}

model ValidationResult {
  id            Int              @id @default(autoincrement())
  documentId    Int              @map("document_id")
  ruleType      ruletype         @map("rule_type")
  status        validationstatus
  message       String?          @db.VarChar(1000)
  details       String?          @db.VarChar(2000)
  fieldName     String?          @map("field_name") @db.VarChar(100)
  expectedValue String?          @map("expected_value") @db.VarChar(500)
  actualValue   String?          @map("actual_value") @db.VarChar(500)
  severity      String?          @db.VarChar(20)
  confidence    Decimal?         @db.Decimal(3, 2)
  aiReasoning   Json?            @map("ai_reasoning") @db.Json
  reviewedAt    DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy    String?          @map("reviewed_by") @db.VarChar(255)
  reviewAction  String?          @map("review_action") @db.VarChar(50)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  document      Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("validation_results")
}

model ChaserRequest {
  id             Int              @id @default(autoincrement())
  engagementId   Int              @map("engagement_id")
  recipientEmail String           @map("recipient_email") @db.VarChar(255)
  recipientName  String?          @map("recipient_name") @db.VarChar(255)
  requestedItems Json             @map("requested_items") @db.Json
  uploadToken    String           @unique @map("upload_token") @db.VarChar(64)
  dueDate        DateTime?        @map("due_date") @db.Date
  status         chaserstatus
  subject        String?          @db.VarChar(255)
  messageBody    String?          @map("message_body") @db.VarChar(5000)
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz(6)
  lastRemindedAt DateTime?        @map("last_reminded_at") @db.Timestamptz(6)
  reminderCount  Int              @map("reminder_count")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  engagement     Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  responses      ChaserResponse[]

  @@map("chaser_requests")
}

model ChaserResponse {
  id                Int           @id @default(autoincrement())
  chaserRequestId   Int           @map("chaser_request_id")
  responderEmail    String?       @map("responder_email") @db.VarChar(255)
  responderName     String?       @map("responder_name") @db.VarChar(255)
  documentsUploaded Int           @map("documents_uploaded")
  notes             String?       @db.VarChar(2000)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chaserRequest     ChaserRequest @relation(fields: [chaserRequestId], references: [id], onDelete: Cascade)

  @@map("chaser_responses")
}

model ChatSession {
  id        Int           @id @default(autoincrement())
  clientId  Int?          @map("client_id")
  title     String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages  ChatMessage[]
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("chat_sessions")
}

model ChatMessage {
  id         Int         @id @default(autoincrement())
  sessionId  Int         @map("session_id")
  role       messagerole
  content    String
  toolCalls  Json?       @map("tool_calls") @db.Json
  toolCallId String?     @map("tool_call_id") @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Account {
  id                       String  @id
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  User                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ============================================================================
// ENTERPRISE SCHEMA MODELS
// ============================================================================

model ClientContact {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  name      String   @db.VarChar(255)
  email     String   @db.VarChar(255)
  role      String?  @db.VarChar(100)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Relationships
  uploadedVersions DocumentVersion[] @relation("UploadedBy")
  assignedItems    RequestItem[]     @relation("AssignedTo")
  auditLogs        AuditLog[]        @relation("ActorContact")

  @@index([clientId])
  @@index([email])
  @@map("client_contacts")
}

model Engagement {
  id             Int             @id @default(autoincrement())
  clientId       Int             @map("client_id")
  engagementType String          @map("engagement_type") @db.VarChar(50)
  periodStart    DateTime        @map("period_start") @db.Date
  periodEnd      DateTime        @map("period_end") @db.Date
  status         String          @default("draft") @db.VarChar(50)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // Relationships
  documents      Document[]
  requestSets    RequestSet[]
  chaserRequests ChaserRequest[]
  auditLogs      AuditLog[]

  @@index([clientId])
  @@index([periodStart, periodEnd])
  @@map("engagements")
}

model DocumentCategory {
  id            Int            @id @default(autoincrement())
  code          String         @unique @db.VarChar(50)
  name          String         @db.VarChar(100)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  documentTypes DocumentType[]

  @@map("document_categories")
}

model DocumentType {
  id                   Int                   @id @default(autoincrement())
  categoryId           Int?                  @map("category_id")
  code                 String                @unique @db.VarChar(50)
  name                 String                @db.VarChar(100)
  clientTypeScope      String?               @map("client_type_scope") @db.VarChar(50)
  requiresCounterparty Boolean               @default(false) @map("requires_counterparty")
  requiresAccount      Boolean               @default(false) @map("requires_account")
  requiresEngagement   Boolean               @default(true) @map("requires_engagement")
  retentionYears       Int                   @default(7) @map("retention_years")
  isActive             Boolean               @default(true) @map("is_active")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category             DocumentCategory?     @relation(fields: [categoryId], references: [id])
  // Relationships
  documents            Document[]
  requestItems         RequestItem[]
  templateItems        RequestTemplateItem[]

  @@index([categoryId])
  @@map("document_types")
}

model Counterparty {
  id               Int        @id @default(autoincrement())
  clientId         Int        @map("client_id")
  counterpartyType String     @map("counterparty_type") @db.VarChar(50)
  name             String     @db.VarChar(255)
  email            String?    @db.VarChar(255)
  externalRef      String?    @map("external_ref") @db.VarChar(100)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client           Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents        Document[]

  @@index([clientId])
  @@index([name])
  @@map("counterparties")
}

model FinancialAccount {
  id           Int        @id @default(autoincrement())
  clientId     Int        @map("client_id")
  accountType  String     @map("account_type") @db.VarChar(50)
  provider     String?    @db.VarChar(100)
  accountName  String     @map("account_name") @db.VarChar(255)
  currencyCode String     @default("GBP") @map("currency_code") @db.VarChar(3)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  client       Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  documents    Document[]

  @@index([clientId])
  @@map("financial_accounts")
}

model FileObject {
  id               Int               @id @default(autoincrement())
  storageProvider  String            @default("s3") @map("storage_provider") @db.VarChar(50)
  bucket           String            @db.VarChar(255)
  objectKey        String            @unique @map("object_key") @db.VarChar(1000)
  byteSize         BigInt            @map("byte_size")
  mimeType         String?           @map("mime_type") @db.VarChar(100)
  checksumSha256   String?           @map("checksum_sha256") @db.VarChar(64)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  documentVersions DocumentVersion[]

  @@index([objectKey])
  @@map("file_objects")
}

model DocumentVersion {
  id                  Int            @id @default(autoincrement())
  documentId          Int            @map("document_id")
  fileObjectId        Int?           @map("file_object_id")
  versionNo           Int            @default(1) @map("version_no")
  uploadedByContactId Int?           @map("uploaded_by_contact_id")
  uploadedAt          DateTime       @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  extractedData       Json?          @map("extracted_data") @db.Json
  extractionStatus    String?        @map("extraction_status") @db.VarChar(50)
  notes               String?        @db.VarChar(2000)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  document            Document       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileObject          FileObject?    @relation(fields: [fileObjectId], references: [id])
  uploadedBy          ClientContact? @relation("UploadedBy", fields: [uploadedByContactId], references: [id])

  @@index([documentId])
  @@index([fileObjectId])
  @@map("document_versions")
}

model RequestSet {
  id           Int           @id @default(autoincrement())
  engagementId Int           @map("engagement_id")
  name         String        @db.VarChar(255)
  status       String        @default("draft") @db.VarChar(50)
  dueDate      DateTime?     @map("due_date") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  engagement   Engagement    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  requestItems RequestItem[]

  @@index([engagementId])
  @@map("request_sets")
}

model RequestItem {
  id                  Int            @id @default(autoincrement())
  requestSetId        Int            @map("request_set_id")
  documentTypeId      Int?           @map("document_type_id")
  description         String?        @db.VarChar(500)
  expectedCount       Int            @default(1) @map("expected_count")
  isRequired          Boolean        @default(true) @map("is_required")
  status              String         @default("pending") @db.VarChar(50)
  assignedToContactId Int?           @map("assigned_to_contact_id")
  dueDate             DateTime?      @map("due_date") @db.Date
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  requestSet          RequestSet     @relation(fields: [requestSetId], references: [id], onDelete: Cascade)
  documentType        DocumentType?  @relation(fields: [documentTypeId], references: [id])
  assignedTo          ClientContact? @relation("AssignedTo", fields: [assignedToContactId], references: [id])
  documents           Document[]     @relation("RequestItemDocuments")

  @@index([requestSetId])
  @@index([documentTypeId])
  @@map("request_items")
}

model RequestTemplate {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(255)
  clientType     String?               @map("client_type") @db.VarChar(50)
  engagementType String?               @map("engagement_type") @db.VarChar(50)
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  templateItems  RequestTemplateItem[]

  @@map("request_templates")
}

model RequestTemplateItem {
  id             Int             @id @default(autoincrement())
  templateId     Int             @map("template_id")
  documentTypeId Int?            @map("document_type_id")
  description    String?         @db.VarChar(500)
  expectedCount  Int             @default(1) @map("expected_count")
  isRequired     Boolean         @default(true) @map("is_required")
  orderIndex     Int             @default(0) @map("order_index")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  template       RequestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documentType   DocumentType?   @relation(fields: [documentTypeId], references: [id])

  @@index([templateId])
  @@map("request_template_items")
}

model AuditLog {
  id             Int            @id @default(autoincrement())
  clientId       Int?           @map("client_id")
  engagementId   Int?           @map("engagement_id")
  entityType     String         @map("entity_type") @db.VarChar(50)
  entityId       Int            @map("entity_id")
  action         String         @db.VarChar(100)
  actorContactId Int?           @map("actor_contact_id")
  changes        Json?          @db.Json
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  client         Client?        @relation(fields: [clientId], references: [id])
  engagement     Engagement?    @relation(fields: [engagementId], references: [id])
  actorContact   ClientContact? @relation("ActorContact", fields: [actorContactId], references: [id])

  @@index([clientId])
  @@index([engagementId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Post {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  createdById String
  User        User     @relation(fields: [createdById], references: [id])

  @@index([name])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  Account       Account[]
  Post          Post[]
  Session       Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

enum chaserstatus {
  DRAFT
  SENT
  REMINDED
  PARTIALLY_RECEIVED
  COMPLETE
  EXPIRED
}

enum documentstatus {
  PENDING
  PROCESSING
  EXTRACTED
  VALIDATED
  FAILED
}

enum entitytype {
  SOLE_TRADER
  PARTNERSHIP
  LLP
  LIMITED_COMPANY
  PLC
  CHARITY
  OTHER
}

enum messagerole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ruletype {
  REQUIRED_FIELDS
  VAT_NUMBER_FORMAT
  DATE_IN_PERIOD
  TOTALS_MATCH
  VAT_RATE_VALID
  DUPLICATE_DETECTION
  AI_ANOMALY
  CURRENCY_VALID
  SUPPLIER_VALID
  ACCOUNT_HOLDER_MATCH
}

enum validationstatus {
  PASSED
  FAILED
  WARNING
  SKIPPED
}
