generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(255)
  vatNumber    String?       @unique @map("vat_number") @db.VarChar(20)
  entityType   entitytype    @map("entity_type")
  contactEmail String?       @map("contact_email") @db.VarChar(255)
  contactName  String?       @map("contact_name") @db.VarChar(255)
  address      String?       @db.VarChar(500)
  notes        String?       @db.VarChar(2000)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chatSessions ChatSession[]
  vatPeriods   VATPeriod[]

  @@map("clients")
}

model VATPeriod {
  id             Int               @id @default(autoincrement())
  clientId       Int               @map("client_id")
  periodStart    DateTime          @map("period_start") @db.Date
  periodEnd      DateTime          @map("period_end") @db.Date
  dueDate        DateTime?         @map("due_date") @db.Date
  status         periodstatus
  isLocked       Boolean           @map("is_locked")
  reference      String?           @db.VarChar(100)
  notes          String?           @db.VarChar(2000)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditTrail     AuditTrailEntry[]
  chaserRequests ChaserRequest[]
  evidenceItems  EvidenceItem[]
  client         Client            @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("vat_periods")
}

model EvidenceItem {
  id            Int              @id @default(autoincrement())
  vatPeriodId   Int              @map("vat_period_id")
  category      evidencecategory
  description   String?          @db.VarChar(500)
  status        evidencestatus
  expectedCount Int              @map("expected_count")
  receivedCount Int              @map("received_count")
  notes         String?          @db.VarChar(2000)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents     Document[]
  vatPeriod     VATPeriod        @relation(fields: [vatPeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("evidence_items")
}

model Document {
  id                Int                @id @default(autoincrement())
  evidenceItemId    Int?               @map("evidence_item_id")
  filename          String             @db.VarChar(500)
  s3Key             String             @unique @map("s3_key") @db.VarChar(1000)
  fileHash          String             @map("file_hash") @db.VarChar(64)
  contentType       String?            @map("content_type") @db.VarChar(100)
  fileSize          Int?               @map("file_size")
  status            documentstatus
  documentType      documenttype?      @map("document_type")
  processingError   String?            @map("processing_error") @db.VarChar(2000)
  extractedData     Json?              @map("extracted_data") @db.Json
  invoiceNumber     String?            @map("invoice_number") @db.VarChar(100)
  invoiceDate       DateTime?          @map("invoice_date") @db.Date
  supplierName      String?            @map("supplier_name") @db.VarChar(255)
  supplierVatNumber String?            @map("supplier_vat_number") @db.VarChar(20)
  customerName      String?            @map("customer_name") @db.VarChar(255)
  customerVatNumber String?            @map("customer_vat_number") @db.VarChar(20)
  netAmount         Decimal?           @map("net_amount") @db.Decimal(12, 2)
  vatAmount         Decimal?           @map("vat_amount") @db.Decimal(12, 2)
  grossAmount       Decimal?           @map("gross_amount") @db.Decimal(12, 2)
  vatRate           Decimal?           @map("vat_rate") @db.Decimal(5, 2)
  currency          String?            @db.VarChar(3)
  description       String?            @db.VarChar(2000)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  evidenceItem      EvidenceItem?      @relation(fields: [evidenceItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  validationResults ValidationResult[]

  @@index([fileHash], map: "ix_documents_file_hash")
  @@map("documents")
}

model ValidationResult {
  id            Int              @id @default(autoincrement())
  documentId    Int              @map("document_id")
  ruleType      ruletype         @map("rule_type")
  status        validationstatus
  message       String?          @db.VarChar(1000)
  details       String?          @db.VarChar(2000)
  fieldName     String?          @map("field_name") @db.VarChar(100)
  expectedValue String?          @map("expected_value") @db.VarChar(500)
  actualValue   String?          @map("actual_value") @db.VarChar(500)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  document      Document         @relation(fields: [documentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("validation_results")
}

model AuditTrailEntry {
  id          Int       @id @default(autoincrement())
  vatPeriodId Int       @map("vat_period_id")
  action      String    @db.VarChar(100)
  description String?   @db.VarChar(2000)
  performedBy String?   @map("performed_by") @db.VarChar(255)
  performedAt DateTime  @map("performed_at") @db.Timestamptz(6)
  entityType  String?   @map("entity_type") @db.VarChar(50)
  entityId    Int?      @map("entity_id")
  oldValue    String?   @map("old_value") @db.VarChar(2000)
  newValue    String?   @map("new_value") @db.VarChar(2000)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vatPeriod   VATPeriod @relation(fields: [vatPeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit_trail_entries")
}

model ChaserRequest {
  id             Int              @id @default(autoincrement())
  vatPeriodId    Int              @map("vat_period_id")
  recipientEmail String           @map("recipient_email") @db.VarChar(255)
  recipientName  String?          @map("recipient_name") @db.VarChar(255)
  requestedItems Json             @map("requested_items") @db.Json
  uploadToken    String           @unique @map("upload_token") @db.VarChar(64)
  dueDate        DateTime?        @map("due_date") @db.Date
  status         chaserstatus
  subject        String?          @db.VarChar(255)
  messageBody    String?          @map("message_body") @db.VarChar(5000)
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz(6)
  lastRemindedAt DateTime?        @map("last_reminded_at") @db.Timestamptz(6)
  reminderCount  Int              @map("reminder_count")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  vatPeriod      VATPeriod        @relation(fields: [vatPeriodId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responses      ChaserResponse[]

  @@map("chaser_requests")
}

model ChaserResponse {
  id                Int           @id @default(autoincrement())
  chaserRequestId   Int           @map("chaser_request_id")
  responderEmail    String?       @map("responder_email") @db.VarChar(255)
  responderName     String?       @map("responder_name") @db.VarChar(255)
  documentsUploaded Int           @map("documents_uploaded")
  notes             String?       @db.VarChar(2000)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  chaserRequest     ChaserRequest @relation(fields: [chaserRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("chaser_responses")
}

model ChatSession {
  id        Int           @id @default(autoincrement())
  clientId  Int?          @map("client_id")
  title     String?       @db.VarChar(255)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  messages  ChatMessage[]
  client    Client?       @relation(fields: [clientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("chat_sessions")
}

model ChatMessage {
  id         Int         @id @default(autoincrement())
  sessionId  Int         @map("session_id")
  role       messagerole
  content    String
  toolCalls  Json?       @map("tool_calls") @db.Json
  toolCallId String?     @map("tool_call_id") @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("chat_messages")
}

model Account {
  id                       String  @id
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  User                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AutoChaser {
  id            String      @id
  clientSetupId String
  trigger       String
  delayDays     Int
  message       String
  createdAt     DateTime    @default(now())
  ClientSetup   ClientSetup @relation(fields: [clientSetupId], references: [id], onDelete: Cascade)

  @@index([clientSetupId])
}

model BankConnection {
  id               String      @id
  clientSetupId    String
  plaidAccessToken String
  plaidItemId      String
  accountId        String
  accountName      String
  accountMask      String?
  accountType      String
  accountSubtype   String?
  institutionName  String
  institutionId    String
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  ClientSetup      ClientSetup @relation(fields: [clientSetupId], references: [id], onDelete: Cascade)

  @@index([clientSetupId])
  @@index([plaidItemId])
}

model ChecklistItem {
  id              String      @id
  clientSetupId   String
  itemId          String
  title           String
  required        Boolean
  status          String
  acceptance      String
  ctaAction       String
  ctaData         String?
  uploadedFileUrl String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  ClientSetup     ClientSetup @relation(fields: [clientSetupId], references: [id], onDelete: Cascade)

  @@index([clientSetupId])
}

model ClientSetup {
  id              String           @id
  email           String
  clientName      String
  entityType      String
  vatScheme       String
  vatPeriodStart  DateTime
  vatPeriodEnd    DateTime
  vatPeriodLabel  String
  bankAccounts    String[]
  salesChannels   String[]
  notes           String?
  backendClientId Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  AutoChaser      AutoChaser[]
  BankConnection  BankConnection[]
  ChecklistItem   ChecklistItem[]

  @@index([email])
  @@index([backendClientId])
}

model Post {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  createdById String
  User        User     @relation(fields: [createdById], references: [id])

  @@index([name])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  Account       Account[]
  Post          Post[]
  Session       Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

enum chaserstatus {
  DRAFT
  SENT
  REMINDED
  PARTIALLY_RECEIVED
  COMPLETE
  EXPIRED
}

enum documentstatus {
  PENDING
  PROCESSING
  EXTRACTED
  VALIDATED
  FAILED
}

enum documenttype {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  RECEIPT
  BANK_STATEMENT
  CONTRACT
  IMPORT_DECLARATION
  EXPORT_DECLARATION
  VAT_CERTIFICATE
  OTHER
}

enum entitytype {
  SOLE_TRADER
  PARTNERSHIP
  LLP
  LIMITED_COMPANY
  PLC
  CHARITY
  OTHER
}

enum evidencecategory {
  SALES_INVOICES
  PURCHASE_INVOICES
  CREDIT_NOTES
  DEBIT_NOTES
  BANK_STATEMENTS
  RECEIPTS
  CONTRACTS
  IMPORT_DOCUMENTS
  EXPORT_DOCUMENTS
  VAT_CERTIFICATES
  OTHER
}

enum evidencestatus {
  PENDING
  PARTIAL
  COMPLETE
  VALIDATED
  EXCEPTION
}

enum messagerole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum periodstatus {
  DRAFT
  IN_PROGRESS
  UNDER_REVIEW
  READY
  SUBMITTED
  LOCKED
}

enum ruletype {
  REQUIRED_FIELDS
  VAT_NUMBER_FORMAT
  DATE_IN_PERIOD
  TOTALS_MATCH
  VAT_RATE_VALID
  DUPLICATE_DETECTION
  AI_ANOMALY
  CURRENCY_VALID
  SUPPLIER_VALID
}

enum validationstatus {
  PASSED
  FAILED
  WARNING
  SKIPPED
}
